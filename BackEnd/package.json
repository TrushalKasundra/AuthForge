{
  "name": "backend",
  "version": "1.0.0",
  "description": "AuthForge Backend API - JWT Authentication Server",
  "license": "ISC",
  "author": "Trushal",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src"
  },
  "dependencies": {
    "@authforge/shared": "*",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "es-errors": "^1.3.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.22.0",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.2",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "3.2.3",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "tsc-alias": "1.9.2",
    "tsx": "4.19.4",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.3"
  }
