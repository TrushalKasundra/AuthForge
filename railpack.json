{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "npm install"
      ]
    },
    "build": {
      "commands": [
        "npm run build -w packages/shared",
        "npm run build -w BackEnd"
      ]
    }
  },
  "deploy": {
    "startCommand": "node BackEnd/dist/index.js",
    "healthcheckPath": "/api/health"
  }
}
